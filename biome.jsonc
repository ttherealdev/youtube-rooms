{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.output",
      "!**/.tanstack",
      "!**/.nitro",
      "!**/node_modules",
      "!**/target",
      // Generated by the TanStack Router plugin; editing it is pointless and
      // linting it is noise.
      "!**/routeTree.gen.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "css": {
    // Tailwind v4 keeps design tokens in CSS (`@theme`, `@utility`), which
    // Biome parses only with this opt-in.
    "parser": { "tailwindDirectives": true }
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": { "level": "warn", "options": { "allow": ["warn", "error"] } }
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "warn"
      },
      "style": {
        "useConst": "error",
        "noNonNullAssertion": "error",
        "useImportType": "error"
      },
      "a11y": {
        // Every SVG in components/illustrations is decorative and marked
        // `aria-hidden`; its accessible name comes from the surrounding
        // EmptyState or Button. Biome flags aria-hidden SVGs regardless, so
        // this rule would only ever produce false positives here.
        "noSvgWithoutTitle": "off"
      }
    }
  }
}
