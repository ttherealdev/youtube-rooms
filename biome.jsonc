{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.output",
      "!**/.tanstack",
      "!**/.nitro",
      "!**/node_modules",
      "!**/target",
      "!**/.next",
      // Regenerated by the TanStack Router plugin on every dev start and
      // build, so any fix applied here is reverted moments later.
      "!apps/web/src/routeTree.gen.ts",
      // Vendored by the shadcn CLI and re-fetched on every `shadcn add`.
      // Formatting or fixing them locally is undone the next time the CLI
      // runs, so they are treated as generated code rather than as ours.
      "!apps/web/src/components/ui"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "css": {
    // Tailwind v4 keeps design tokens in CSS (`@theme`, `@utility`), which
    // Biome parses only with this opt-in.
    "parser": { "tailwindDirectives": true }
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": { "level": "warn", "options": { "allow": ["warn", "error"] } }
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "warn"
      },
      "style": {
        "useConst": "error",
        "noNonNullAssertion": "error",
        "useImportType": "error",
        // Both the theme-swap guard and the reduced-motion block are universal
        // `!important` resets that must reach every element and pseudo-element.
        // Source order is irrelevant to a declaration that already wins, so
        // this rule only ever reports false positives in this sheet.
        "noDescendingSpecificity": "off"
      },
      "a11y": {
        // Decorative SVGs are marked `aria-hidden` and take their accessible
        // name from the surrounding button or empty state. Biome flags them
        // regardless, so this rule only ever produces false positives here.
        "noSvgWithoutTitle": "off"
      },
      "performance": {
        // Room artwork comes from YouTube and from arbitrary playlist logos
        // that frequently 404. `next/image` would need an allowlist per host
        // and turns a dead thumbnail into a server-side fetch error, so plain
        // <img> with an onError fallback is the deliberate choice.
        "noImgElement": "off"
      }
    }
  }
}
