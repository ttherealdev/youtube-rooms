{
  "name": "playercn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:protocol": "pnpm --filter @playercn/protocol test",
    "server:dev": "cargo run --manifest-path apps/server/Cargo.toml",
    "server:check": "cargo check --manifest-path apps/server/Cargo.toml --all-targets",
    "server:lint": "cargo clippy --manifest-path apps/server/Cargo.toml --all-targets -- -D warnings",
    "server:test": "cargo test --manifest-path apps/server/Cargo.toml",
    "db:migrate": "sqlx migrate run --source apps/server/migrations",
    "db:prepare": "cargo sqlx prepare --workspace -- --manifest-path apps/server/Cargo.toml",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d postgres redis"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2"
  }
}
