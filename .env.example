# =============================================================================
# playercn — environment
# =============================================================================
# Copy to `.env` and fill in. Everything marked REQUIRED is validated at boot:
# the server refuses to start with a precise message rather than failing on the
# first request that happens to need the value.
#
# Generate the JWT keypair first:   ./scripts/gen-keys.sh
# =============================================================================

# --- Core --------------------------------------------------------------------

# development | production. Production additionally enforces secure cookies
# and an https web origin.
APP_ENV=development

BIND_ADDR=0.0.0.0:8080

# Where the API is reachable from the internet. Used to build the Google OAuth
# redirect URI when GOOGLE_REDIRECT_URI is not set explicitly.
PUBLIC_URL=http://localhost:8080

# The browser origin. Sets CORS and is the only destination the OAuth flow will
# redirect back to.
WEB_ORIGIN=http://localhost:3000

# Read the caller's IP from CF-Connecting-IP / X-Forwarded-For.
# REQUIRED (true) behind any reverse proxy — Traefik, Caddy, Cloudflare. The TCP
# peer is then the proxy, so without this every user in the world shares a
# single rate-limit bucket and the site starts returning 429 under trivial load.
# Leave false only when the process is directly internet-facing: a reachable
# origin that trusts these headers lets any client forge an identity.
# docker-compose.prod.yml sets this to true for you.
TRUST_PROXY_HEADERS=false

# --- Datastores (REQUIRED) ----------------------------------------------------

DATABASE_URL=postgres://ytroom:ytroom@localhost:5432/ytroom
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=2
DATABASE_ACQUIRE_TIMEOUT_SECS=10

REDIS_URL=redis://localhost:6379

# --- Tokens (REQUIRED) --------------------------------------------------------
# Ed25519 PKCS#8 PEM. Either paste inline (with literal \n escapes) or point at
# a file — Docker secrets and Dokploy's UI disagree about which is idiomatic,
# so both work.
#
#   JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4...\n-----END PRIVATE KEY-----\n"
#
JWT_PRIVATE_KEY_FILE=./keys/jwt-private.pem
JWT_PUBLIC_KEY_FILE=./keys/jwt-public.pem

ACCESS_TOKEN_TTL_SECS=900          # 15 minutes, held in browser memory only
REFRESH_TOKEN_TTL_SECS=2592000     # 30 days, httpOnly cookie, rotated on use
WS_TICKET_TTL_SECS=30              # single-use socket credential

# Leave empty in almost all cases, including split api./app. subdomains: only
# the API ever reads this cookie, so a host-only cookie is correct and narrower.
# Sibling subdomains still count as same-site, so SameSite=Lax is satisfied.
# Set it only if a second service on another subdomain must read the cookie.
COOKIE_DOMAIN=
# Defaults to true in production and false in development, which is almost
# always what you want. The server refuses to start if it is false in
# production. Only set it explicitly to override that.
# COOKIE_SECURE=

# --- Google Sign-In -----------------------------------------------------------
# Nominally optional, but note: guests can join rooms and cannot create them, so
# with these unset *nobody* can create a room and the deployment is a dead end.
# Set them unless you are seeding rooms another way.
#
# In Google Cloud Console create an OAuth 2.0 Web client and add
# `${PUBLIC_URL}/api/auth/google/callback` as an authorised redirect URI.
# Scopes requested: openid, email, profile. Nothing else.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- YouTube Data API (optional) ----------------------------------------------
# Without a key, in-app search is disabled but pasting links still works.
# Server-side only; never exposed to the browser.
YOUTUBE_API_KEY=
YOUTUBE_CACHE_TTL_SECS=43200

# --- Realtime -----------------------------------------------------------------
WS_HEARTBEAT_SECS=15
WS_CLIENT_TIMEOUT_SECS=30          # must exceed the heartbeat
WS_HANDSHAKE_TIMEOUT_SECS=5
WS_SEND_BUFFER=256                 # outbound queue before a slow client is cut

ROOM_LEASE_TTL_SECS=30             # how long a node owns a room without renewal
ROOM_LEASE_RENEW_SECS=10           # must be well below the TTL

# --- Voice --------------------------------------------------------------------
# Mesh WebRTC collapses past ~8 peers on residential upstream.
VOICE_MESH_MAX_PEERS=8

STUN_URLS=stun:stun.l.google.com:19302

# TURN is needed for symmetric NAT (a meaningful minority of mobile networks).
# Without it, some users will connect to everything except voice.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Rate limits --------------------------------------------------------------
# Sliding windows in Redis, shared across all nodes.
RL_CHAT_PER_MIN=30
RL_QUEUE_PER_MIN=20
RL_SYNC_PER_MIN=60
RL_REACTION_PER_MIN=40
RL_ROOMS_PER_HOUR=10
RL_HTTP_PER_MIN=300

# --- Observability ------------------------------------------------------------
# Standard tracing filter. `debug` in development, `info,sqlx=warn` in prod.
# debug for local work; use info,sqlx=warn in production, where debug logs
# every query and request at volume.
RUST_LOG=debug,sqlx=info

# --- Web build ----------------------------------------------------------------
# Inlined into the client bundle at build time. Leave empty for same-origin
# deployments (the dev server proxies /api and /ws).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# --- Production deployment (docker-compose.prod.yml) --------------------------
DOMAIN=playercn.mak3r.net
API_DOMAIN=api.playercn.mak3r.net
POSTGRES_USER=ytroom
POSTGRES_PASSWORD=
POSTGRES_DB=ytroom
